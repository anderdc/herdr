# herdr-auto-title config. Symlinked to ~/.config/herdr-auto-title/config.env
# (install-plugins.sh makes the link). Read once at startup — after editing run:
#   herdr plugin action invoke herdr.auto-title.restart

# Longest title, in columns (default 50 — too long for a tab bar with several tabs).
HERDR_AUTO_TITLE_MAX_LENGTH=28

# Longest branch shown in a title; 0 leaves branches out.
HERDR_AUTO_TITLE_BRANCH_MAX=10

# Agent name off: the sidebar already shows each pane's vendor and status, so the
# columns go to what the agent is doing instead. A pane whose agent has reported
# nothing is named after its directory.
HERDR_AUTO_TITLE_AGENT_NAME=false

# Keep the tab position in front, so prefix+1..9 still reads off the tab bar.
HERDR_AUTO_TITLE_POSITION=true
